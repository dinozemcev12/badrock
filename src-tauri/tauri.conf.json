{
  "$schema": "https://tauri.app/schema/v1/config.json",
  "package": {
    "productName": "Badrock",
    "version": "1.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": true,
      "dialog": { "all": true },
      "fs": {
        "all": true,
        "readFile": true,
        "writeFile": true,
        "readDir": true,
        "createDir": true,
        "removeFile": true,
        "renameFile": true,
        "copyFile": true,
        "exists": true
      },
      "shell": { "all": false },
      "globalShortcut": { "all": true },
      "window": { "all": true },
      "notification": { "all": true },
      "path": { "all": true }
    },
    "windows": [
      {
        "title": "Badrock",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "alwaysOnTop": false
      }
    ],
    "security": {
      "csp": null
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.bedrock.notes"
    }
  }
}
